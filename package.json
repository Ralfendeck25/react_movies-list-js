  "dependencies": {
    "bulma": "^0.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "sass": "^1.72.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "cypress": "^13.6.4",
    "cypress-axe": "^1.6.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.1.1",
    "mochawesome": "^7.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^4.0.0",
    "vite-plugin-checker": "^0.7.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build --base=/react_movies-list-js/",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -r https://github.com/ralfendeck25/react_movies-list-js.git",
    "lint": "eslint --fix --ext .js,.jsx,ts,tsx src && stylelint 'src/**/*.scss' --fix",
    "test": "cypress open",
    "test:ci": "cypress run",
    "type-check": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "airbnb",
      "prettier"
    ]
  }
}
